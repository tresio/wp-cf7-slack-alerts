{
    "name": "tresio/cf7-slack-error-alerts",
    "description": "Sends a Slack notification when a Contact Form 7 form errors.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6",
        "yoast/phpunit-polyfills": "^1.1",
        "brain/monkey": "^2.6",
        "wp-phpunit/wp-phpunit": "^6.4"
    },
    "autoload-dev": {
        "psr-4": {
            "CF7_Slack_Alerts\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:integration": "phpunit --configuration phpunit-integration.xml.dist",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './dist/*' -print0 | xargs -0 -n1 -P4 php -l"
    }
}
